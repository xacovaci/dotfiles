# Updating Debian:
sudo apt update
sudo apt upgrade

# Installing Packages:
# essential tools
sudo apt install fastfetch curl wget build-essential make cmake ninja-build git tig gh stow zsh fzf tree ripgrep gettext tmux htop lsd zsh-autosuggestions zsh-syntax-highlighting

# Sway suit for Wayland + Kitty Terminal
sudo apt install sway swaybg swayidle swaylock wl-clipboard waybar kitty rofi

# Wayland compatibility layer for X
sudo apt install xwayland

# user apps
sudo apt install chromium ranger pcmanfm vlc eog evince okular keepassxc

# installing librewolf
sudo apt update && sudo apt install extrepo -y
sudo extrepo enable librewolf
sudo apt update && sudo apt install librewolf -y

# archival tools
sudo apt install tar zip unzip p7zip-full unrar xarchiver

# dev tools
sudo apt install python3 python3-pip python3-venv nodejs npm

# fonts
sudo apt install fonts-noto fonts-noto-color-emoji

# set default shell
chsh -s $(which zsh)

# extra fonts
cd Downloads
wget https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Hack.tar.xz
wget https://github.com/ryanoasis/nerd-fonts/releases/latest/download/RobotoMono.tar.xz
wget https://github.com/ryanoasis/nerd-fonts/releases/latest/download/DejaVuSansMono.tar.xz
wget https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz

mkdir ~/.local/share/fonts
tar -xf Hack.tar.xz -C ~/.local/share/fonts
tar -xf RobotoMono.tar.xz -C ~/.local/share/fonts
tar -xf DejaVuSansMono.tar.xz -C ~/.local/share/fonts
tar -xf JetBrainsMono.tar.xz -C ~/.local/share/fonts

cd ~
fc-cache -fv
# note: remember to execute `fc-cache -fv` after applying font configs

# audio servers and enabling them
sudo apt install pipewire pipewire-pulse pipewire-audio-client-libraries libspa-0.2-bluetooth libspa-0.2-jack gstreamer1.0-pipewire

# efficient power management (tlp, etc.)
sudo apt install tlp tlp-rdw

# firewall and its configuration
sudo apt install ufw

# firewall rules
sudo ufw default deny incoming
sudo ufw default allow outgoing

# activate firewall
sudo ufw enable




# Depricated XD (I don't use it anymore!)
# required for building suckless apps
sudo apt install libx11-dev libxft-dev libxinerama-dev libxext-dev libxrandr-dev 
sudo apt install libfribidi-dev # only for bidi patch in dwm

# window manager tools (for DWM)
sudo apt install picom feh arandr lxappearance brightnessctl maim

# if core minimal debian is installed:
# display server and display related stuff
sudo apt install xorg xclip xsel fontconfig gnome-themes-extra
